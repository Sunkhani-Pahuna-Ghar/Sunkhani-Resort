# Copy to .env and fill in. NEVER commit .env.
MONGODB_URI=mongodb://localhost:27017/sunkhani
JWT_SECRET=replace-with-a-long-random-string   # e.g. run: openssl rand -hex 32
JWT_EXPIRATION=24h
PORT=5001

# Website address(es) allowed to call the API from a browser, comma separated
CORS_ORIGINS=http://localhost:5173
# Used to build the link in password-reset emails
FRONTEND_URL=http://localhost:5173

# Who receives "new booking request" and "new message" emails
OWNER_EMAIL=

# Email sending. Leave SMTP_HOST empty in development: emails are only printed in the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Set to 1 when the server runs behind a proxy (so rate limiting sees the real visitor IP)
# TRUST_PROXY=1
